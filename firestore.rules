rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
             data.gamesPlayed is int && data.gamesPlayed >= 0 &&
             data.gamesWon is int && data.gamesWon >= 0 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500));
    }

    function isValidLudoRoom(data) {
      return data.roomId is string && data.roomId.size() >= 3 && data.roomId.size() <= 64 &&
             data.hostId is string && data.hostId.size() <= 128 &&
             data.status in ['waiting', 'playing', 'finished'] &&
             data.isPublic is bool &&
             data.maxPlayers is int && data.maxPlayers >= 2 && data.maxPlayers <= 4 &&
             data.playerIds is list && data.playerIds.size() >= 1 && data.playerIds.size() <= 4 &&
             data.players is list && data.players.size() >= 1 && data.players.size() <= 4 &&
             data.turn is string && data.turn in ['red', 'green', 'yellow', 'blue'] &&
             (!('dice' in data) || data.dice == null || (data.dice is int && data.dice >= 0 && data.dice <= 6)) &&
             data.rolled is bool &&
             (!('winner' in data) || data.winner == null || (data.winner is string && data.winner.size() <= 20)) &&
             data.tokens is map &&
             data.activeColors is list && data.activeColors.size() >= 1 && data.activeColors.size() <= 4 &&
             (!('name' in data) || (data.name is string && data.name.size() <= 60)) &&
             (!('noAiMode' in data) || data.noAiMode is bool) &&
             (!('recentChat' in data) || data.recentChat is map) &&
             (!('voiceState' in data) || data.voiceState is map);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isSignedIn() && (resource.data.isPublic == true || request.auth.uid in resource.data.playerIds);
      allow create: if isSignedIn() && isValidId(roomId) &&
                       incoming().hostId == request.auth.uid &&
                       request.auth.uid in incoming().playerIds &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidLudoRoom(incoming());
      allow update: if isSignedIn() && isValidId(roomId) &&
                       (
                         // Existing participant can update game state
                         request.auth.uid in existing().playerIds ||
                         // New player can join waiting room with available slot
                         (existing().status == 'waiting' && existing().playerIds.size() < existing().maxPlayers)
                       ) &&
                       incoming().hostId == existing().hostId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidLudoRoom(incoming());
      allow delete: if isSignedIn() && isValidId(roomId) && existing().hostId == request.auth.uid;

      match /messages/{msgId} {
        allow read, create: if isSignedIn() && isValidId(roomId);
      }
    }
  }
}
